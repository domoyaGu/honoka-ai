# 复制为 .env 后填写；勿提交 .env

# OpenAI 兼容（Ollama 示例：http://127.0.0.1:11434/v1）
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# API（Node apps/api 与 Java apps/api-java 共用端口，勿同时启动）
API_PORT=8788
# 可选：覆盖 Java 上传目录（默认相对 apps/api-java 的 ../../data/uploads）
# HONOKA_UPLOADS_DIR=D:/git/honoka-ai/data/uploads
# 可选：简单鉴权
# API_TOKEN=dev-token
