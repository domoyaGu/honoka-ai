# 复制为 .env 后填写；勿提交 .env

# OpenAI 兼容（Ollama 示例：http://127.0.0.1:11434/v1）
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# API（Node apps/api 与 Java apps/api-java 共用端口，勿同时启动）
API_PORT=8788
# 可选：覆盖数据目录（默认相对 apps/api-java 的 ../../data/*）
# HONOKA_UPLOADS_DIR=D:/git/honoka-lite/data/uploads
# HONOKA_SAMPLES_DIR=D:/git/honoka-lite/data/samples
# HONOKA_INDEX_DIR=D:/git/honoka-lite/data/index
# HONOKA_RAG_CHUNK_SIZE=500
# HONOKA_RAG_CHUNK_OVERLAP=60
# HONOKA_RAG_TOP_K=4
# 可选：简单鉴权
# API_TOKEN=dev-token
