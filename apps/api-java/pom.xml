<?xml version="1.0" encoding="UTF-8"?>
<!--
  Honoka Java API（阶段 A 并行后端）
  - Spring Boot 3 + Java 17：对照你已学过的 Spring Boot，便于阶段 B 接 JPA / Security / 定时任务
  - 接口形状与 apps/api（Node）对齐，前端 utils/request 无需改
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.4</version>
    <relativePath/>
  </parent>

  <groupId>com.honoka</groupId>
  <artifactId>api-java</artifactId>
  <version>0.1.0</version>
  <name>honoka-api-java</name>
  <description>Honoka Stage A API (Spring Boot)</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Web MVC：REST + 文件上传 + SseEmitter 流式（阶段 A 够用，比 WebFlux 好上手） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 校验注解，阶段 B 表单/鉴权入参可直接用 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
