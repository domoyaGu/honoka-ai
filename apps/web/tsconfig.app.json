/**
 * 浏览器 / Vue 应用侧 TS 配置：管 src 下的页面、组件、工具
 *
 * 和 tsconfig.node.json 拆开：
 * - app：DOM + Vue（本文件，extends Vue 官方 DOM 预设）
 * - node：Vite 配置等 Node 脚本
 *
 * 根 tsconfig.json 用 references 引用本文件。
 * 对照：Vite + Vue 官方脚手架；路径别名与 vite.config.ts 的 alias `@` 一致
 */
{
  // Vue 官方 DOM 预设：含 lib DOM、jsx 等浏览器侧默认项
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    // 增量编译缓存；放 node_modules/.tmp 避免污染源码树
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // 与 vite resolve.alias `@` → src 对齐，TS 才能解析 `import ... from "@/..."`
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // 只检查业务源码；vite.config.ts 归 node 那份配置
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
